[Unit]
Description=Nacencomm Invoice Management ASP.NET Core Web App
After=network.target

[Service]
WorkingDirectory=/var/www/invoice-app
ExecStart=/usr/bin/dotnet /var/www/invoice-app/Nacencomm.InvoiceManagement.dll
Restart=always
# Restart service after 10 seconds if dotnet service crashes
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=invoice-web
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000

[Install]
WantedBy=multi-user.target
