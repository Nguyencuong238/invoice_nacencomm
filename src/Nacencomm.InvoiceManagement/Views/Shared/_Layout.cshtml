<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nacencomm Invoice Signing System</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Header Navigation Bar matching Screenshot -->
    <header>
        <nav class="navbar navbar-expand-lg nacen-navbar py-2">
            <div class="container-fluid px-3">
                <a class="navbar-brand me-4 d-flex align-items-center" href="/">
                    <img src="/images/logonew.png" asp-append-version="true" alt="Nacencomm Logo" style="height: 38px; object-fit: contain;" class="me-2" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="topNavbar">
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var isInvoiceActive = currentController == "Invoice" || (currentController == "Home" && currentAction == "Index");
    var isDownloadActive = currentController == "Home" && currentAction == "Download";
}
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item d-none"><a class="nav-link nacen-nav-link" href="#"><i class="bi bi-people me-1"></i>Quản lý người dùng</a></li>
                        <li class="nav-item d-none"><a class="nav-link nacen-nav-link" href="#"><i class="bi bi-grid me-1"></i>Quản lý danh mục</a></li>
                        <li class="nav-item"><a class="nav-link nacen-nav-link @(isInvoiceActive ? "active fw-bold" : "")" href="/Invoice/Index"><i class="bi bi-file-earmark-receipt me-1"></i>Quản lý hóa đơn</a></li>
                        <li class="nav-item d-none"><a class="nav-link nacen-nav-link" href="#"><i class="bi bi-card-heading me-1"></i>Chứng từ thuế TNCN</a></li>
                        <li class="nav-item d-none"><a class="nav-link nacen-nav-link" href="#"><i class="bi bi-table me-1"></i>Bảng tổng hợp dữ liệu</a></li>
                        <li class="nav-item d-none"><a class="nav-link nacen-nav-link" href="#"><i class="bi bi-graph-up me-1"></i>Thống kê</a></li>
                        <li class="nav-item d-none"><a class="nav-link nacen-nav-link" href="#"><i class="bi bi-search me-1"></i>Tra cứu</a></li>
                        <li class="nav-item"><a class="nav-link nacen-nav-link @(isDownloadActive ? "active fw-bold" : "")" href="/Home/Download"><i class="bi bi-download me-1"></i>Download</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span id="signerStatusBadge" class="badge bg-secondary p-2">
                            <i class="bi bi-arrow-repeat spin me-1"></i> Đang kiểm tra WinForms Signer...
                        </span>
                        <a href="/Home/Download" class="btn btn-sm btn-outline-secondary" title="Hướng dẫn sử dụng WinForms Signer"><i class="bi bi-question-circle"></i></a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container with Left Sidebar & Right Content -->
    <div class="container-fluid px-0">
        <div class="d-flex" style="min-height: calc(100vh - 60px);">
            <!-- Sidebar -->
            <div class="nacen-sidebar py-3 flex-shrink-0">
                <div class="sidebar-header d-none"><i class="bi bi-chevron-down me-1"></i> LẬP HÓA ĐƠN</div>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-file-earmark-plus me-2"></i>Lập hóa đơn</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-files me-2"></i>Lập hóa đơn theo lô</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-pencil-square me-2"></i>Lập hóa đơn điều chỉnh</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-arrow-repeat me-2"></i>Lập hóa đơn thay thế</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-exclamation-octagon me-2"></i>Thông báo HD có sai sót</a>

                <div class="sidebar-header"><i class="bi bi-chevron-down me-1"></i> QUẢN LÝ</div>
                <a href="/Invoice/Index" class="sidebar-menu-item @(isInvoiceActive ? "active" : "")"><i class="bi bi-list-check me-2"></i>Danh sách hóa đơn</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-journal-check me-2"></i>Đăng ký sử dụng</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-card-checklist me-2"></i>Đăng ký sử dụng chứng từ</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-file-earmark-code me-2"></i>Tạo mẫu hóa đơn</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-send me-2"></i>Quản lý phát hành hóa đơn</a>
                <a href="#" class="sidebar-menu-item d-none"><i class="bi bi-bar-chart me-2"></i>Thống kê số lượng hóa đơn</a>
            </div>

            <!-- Content Area -->
            <div class="flex-grow-1 p-4 overflow-auto" style="min-width: 0;">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/winforms-signer.js" asp-append-version="true"></script>
    <script src="~/js/signing-queue.js" asp-append-version="true"></script>
    <script src="~/js/invoice-manager.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
